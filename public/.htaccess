# Candelier IMS - Hostinger (Apache/LiteSpeed)
# Lets React Router handle URLs like /orders/245 on refresh,
# while real files and the /api folder are served normally.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Never rewrite the PHP API
  RewriteRule ^api/ - [L]

  # Serve existing files and folders as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else goes to the React app
  RewriteRule ^ index.html [L]
</IfModule>

# Cache built assets (they have hashed names), never cache index.html
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|svg|png|jpg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
